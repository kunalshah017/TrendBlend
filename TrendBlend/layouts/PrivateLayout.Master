<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PrivateLayout.Master.cs" Inherits="TrendBlend.layouts.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <!-- Basic Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="TrendBlend - Your Personal Digital Wardrobe" />
    <meta name="keywords" content="wardrobe, fashion, clothing, personal style, outfit management" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/favicon/favicon-180x180.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://trendblend.com/" />
    <meta property="og:title" content="TrendBlend - Your Personal Digital Wardrobe" />
    <meta property="og:description" content="Organize and manage your wardrobe digitally with TrendBlend" />
    <meta property="og:image" content="/assets/images/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://trendblend.com/" />
    <meta property="twitter:title" content="TrendBlend - Your Personal Digital Wardrobe" />
    <meta property="twitter:description" content="Organize and manage your wardrobe digitally with TrendBlend" />
    <meta property="twitter:image" content="/assets/images/og-image.png" />


    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="~/styles/Layout/styles.css" rel="stylesheet" />

</head>
<body>
    <form id="serverComponentsForm" runat="server">

        <div class="top_bar">
            <asp:Panel ID="LogoPanel" runat="server" CssClass="top_bar_logo_text">
                <p>Trend Blend</p>
            </asp:Panel>

            <asp:Panel ID="BackButtonPanel" runat="server" Visible="false">
                <a href="javascript:void(0)" onclick="goBack(event)" class="back_button">
                    <i class="fa fa-arrow-left"></i>
                    <asp:Label ID="backLabel" runat="server"></asp:Label>
                </a>
            </asp:Panel>


            <asp:Panel ID="RightButtonPanel" runat="server" CssClass="right_button_panel">
                <asp:HyperLink ID="TopBarSettingsLink" runat="server" NavigateUrl="~/pages/Settings.aspx" CssClass="top_bar_user_account_btn">
                    <i id="TopBarRightIcon" runat="server" class="fa fa-bars"></i>
                </asp:HyperLink>
            </asp:Panel>
        </div>

        <asp:ContentPlaceHolder ID="body" runat="server">
        </asp:ContentPlaceHolder>

        <div class="apparel_upload_form" id="apparelUploadModal">
            <div id="loadingScreen" class="blur_bg" style="display: none;">
                <div class="loading_container">
                    <div class="loading_animation_container">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>
                    <div class="loading_text">
                        <p>
                            Let our AI analyze this for you :)
                        </p>
                        <p>
                            Please add the size according to you
                        </p>
                    </div>
                </div>
            </div>

            <div id="notApparelDialog" class="blur_bg" style="display: none;">
                <div class="dialog_container">
                    <div class="dialog_animation_container">
                        <i class="fa fa-exclamation-circle"></i>
                    </div>
                    <div class="dialog_text">
                        <p>
                            Oops! This doesn't look like an apparel item
           
                        </p>
                        <p>
                            Please try again with a clothing item image
           
                        </p>
                    </div>
                    <button type="button" id="retryButton">
                        <i class="fa fa-refresh"></i>
                        Retry
                   
                    </button>
                </div>
            </div>

            <div class="close_btn_container">
                <i class='bx bx-x'></i>
            </div>

            <div class="camera_container">
                <input type="file"
                    id="cameraInput"
                    accept="image/*"
                    capture="environment"
                    style="display: none;">
                <input type="file"
                    id="galleryInput"
                    accept="image/*"
                    style="display: none;">
                <img id="imgCapture" alt="Captured image" />
                <div class="camera_placeholder" id="cameraPlaceholder">
                    <div class="camera_actions">
                        <button type="button" class="camera_btn" id="openCameraBtn">
                            <i class="fa fa-camera"></i>
                        </button>
                        <button type="button" class="camera_btn" id="openGalleryBtn">
                            <i class="fa fa-image"></i>
                        </button>
                    </div>
                </div>
            </div>


            <div class="input_container">
                <p>Apparel Name</p>
                <asp:TextBox ID="ApparelNameInput" runat="server" CssClass="text_input"></asp:TextBox>
            </div>

            <div class="input_container">
                <p>Type of Apparel</p>
                <asp:DropDownList ID="apparelTypeDropDown" runat="server"
                    CssClass="text_input">
                    <asp:ListItem>Top</asp:ListItem>
                    <asp:ListItem>Bottom</asp:ListItem>
                    <asp:ListItem>Footwear</asp:ListItem>
                    <asp:ListItem>Accessory</asp:ListItem>
                </asp:DropDownList>
            </div>

            <div class="input_container">
                <p>Select your Apparel Color</p>
                <div class="color_input_container">
                    <div class="color_selector">
                        <input type="color" id="customColorInput" class="custom_color_input" value="#ffffff">
                        <i class='bx bxs-pencil custom_color_icon'></i>
                        <asp:HiddenField ID="selectedColorInput" runat="server" EnableViewState="true" />
                    </div>
                    <div class="dominant_colors_container">
                        <!-- Dominant colors will be added here dynamically -->
                    </div>
                </div>
            </div>

            <div class="multi_input_container">
                <div class="input_container">
                    <p>Size</p>
                    <asp:TextBox ID="SizeInput" runat="server" CssClass="text_input" placeholder="M, L, XL / 10, 32, 48" />
                </div>
                <div class="input_container" style="display: none;">
                    <p>Type of Accessory</p>
                    <asp:TextBox ID="AccessoryInput" runat="server" CssClass="text_input" placeholder="Watch, Necklace, Cap, etc..." />
                </div>
            </div>
            <div class="input_container">
                <p>Description</p>
                <asp:TextBox ID="ApparelDescriptionInput" runat="server" CssClass="text_input" TextMode="MultiLine" Rows="5" />
            </div>

            <input type="file" id="fileInput" accept="image/jpeg,image/png" style="display: none;">

            <div class="cta_buttons_container">
                <div id="btnReset">
                    <i class="fa fa-refresh" style="font-size: 2rem; color: var(--magnolia);"></i>
                </div>
                <div id="finalSubmit">
                    <i class="fa fa-check" style="font-size: 2rem; color: var(--magnolia);"></i>
                </div>
            </div>

        </div>

        <div class="bottom_bar">
            <asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/pages/Home.aspx" CssClass="bottom_bar_item" Style="position: absolute; left: 11%; transform: translate(-50%,0);">
                <i class='bx bxs-home'></i>
            </asp:HyperLink>
            <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl="~/pages/Search.aspx" CssClass="bottom_bar_item" Style="position: absolute; left: 29.5%; transform: translate(-50%,0);">
                <i class='bx bx-search-alt' ></i>               
            </asp:HyperLink>
            <div class="bottom_bar_camera_btn" id="apparelUpload" style="font-size: 3rem;">
                <i class='bx bx-plus'></i>
            </div>
            <div class="bottom_bar_item" style="position: absolute; left: 70.5%; transform: translate(-50%,0);">
                <i class="fa fa-star" style="font-size: 1.7rem;"></i>
            </div>
            <asp:HyperLink ID="HyperLink2" runat="server" NavigateUrl="~/pages/Account.aspx" CssClass="bottom_bar_item" Style="position: absolute; left: 89%; transform: translate(-50%,0);">
                <i class="fa fa-user" style="font-size: 1.7rem;"></i>
            </asp:HyperLink>
        </div>
    </form>

    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>

    <script type="text/javascript">
        // Add Color-Thief library to head first
        const colorThiefScript = document.createElement('script');
        colorThiefScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/color-thief/2.3.0/color-thief.umd.js';
        document.head.appendChild(colorThiefScript);

        var colorName;

        $(function () {
            const imgCapture = $('#imgCapture');
            const cameraInput = $('#cameraInput');
            const galleryInput = $('#galleryInput');
            const cameraPlaceholder = $('#cameraPlaceholder');
            const openCameraBtn = $('#openCameraBtn');
            const openGalleryBtn = $('#openGalleryBtn');
            const apparelUploadModal = $('.apparel_upload_form');
            const apparelUploadBtn = $('.bottom_bar_camera_btn');
            const closeModalBtn = $('.close_btn_container .bx-x');
            const customColorInput = $('#customColorInput');
            const selectedColorInput = $("[id$='selectedColorInput']");
            const dominantColorsContainer = $('.dominant_colors_container');
            const finalSubmitBtn = $('#finalSubmit');
            const btnReset = $('#btnReset');
            const username = '<%= Session["UserName"] %>';
            const loadingScreen = $('#loadingScreen');

            let selectedColorBox = null;

            const analyzeWithAI = async (imageData) => {
                try {
                    const serviceUrl = window.location.protocol + '//' + window.location.host + '/services/ApparelService.asmx/GetApparelDetailsFromAI';

                    // Show loading indicator
                    loadingScreen.show();

                    const response = await $.ajax({
                        type: "POST",
                        url: serviceUrl,
                        data: JSON.stringify({ imageData: imageData }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        timeout: 60000,
                        beforeSend: function () {
                        },
                        error: function (xhr, status, error) {
                            console.error('analyzeWithAI: Ajax error', {
                                status: status,
                                error: error,
                                responseText: xhr.responseText
                            });
                        }
                    });

                    loadingScreen.hide();

                    if (!response || !response.d || !response.d.Result) {
                        console.error('analyzeWithAI: Empty or invalid response');
                        throw new Error('Invalid response from service');
                    }

                    // Extract the JSON content from the Result property
                    // The Result contains markdown code blocks with JSON, so we need to extract the JSON part
                    const resultString = response.d.Result;

                    // Extract the JSON part from the markdown code block
                    const jsonMatch = resultString.match(/```json\s*([\s\S]*?)\s*```/);

                    if (!jsonMatch || !jsonMatch[1]) {
                        console.error('analyzeWithAI: Could not extract JSON from response');
                        throw new Error('Invalid JSON format in response');
                    }

                    const jsonString = jsonMatch[1].trim();

                    // Parse the extracted JSON
                    try {
                        const aiResponse = JSON.parse(jsonString);

                        if (aiResponse.notApparel) {
                            // Show not apparel dialog
                            $('#notApparelDialog').show();
                            return;
                        }

                        colorName = aiResponse.colorName || '';

                        // Populate form fields with AI response
                        $("[id$='ApparelNameInput']").val(aiResponse.apparelName || '');
                        $("[id$='apparelTypeDropDown']").val(aiResponse.apparelType || 'Top');
                        $("[id$='ApparelDescriptionInput']").val(aiResponse.description || '');

                        if (aiResponse.apparelType == 'Accessory') {
                            $($("[id$='AccessoryInput']").val(aiResponse.accessoryType || ''));
                        }

                        // Set color
                        if (aiResponse.color) {
                            const hexColor = aiResponse.color;
                            customColorInput.val(hexColor);
                            customColorInput[0].style.backgroundColor = hexColor;
                            selectColor(hexColor);
                        }

                        // Toggle accessory input if needed
                        toggleAccessoryInput();

                        $("[id$='SizeInput']").focus();

                    } catch (parseError) {
                        console.error('analyzeWithAI: JSON parsing error', parseError);
                        throw new Error('Could not parse AI response');
                    }
                } catch (error) {
                    console.error('analyzeWithAI: Error during analysis', error);
                    alert('AI analysis failed: ' + error.message + '. Please fill in details manually.');
                }
            };

            function compressImage(imageData, maxWidth = 1280, maxHeight = 1280, quality = 0.7) {
                return new Promise((resolve) => {
                    const img = new Image();
                    img.onload = function () {
                        let width = img.width;
                        let height = img.height;

                        // Calculate new dimensions
                        if (width > height) {
                            if (width > maxWidth) {
                                height *= maxWidth / width;
                                width = maxWidth;
                            }
                        } else {
                            if (height > maxHeight) {
                                width *= maxHeight / height;
                                height = maxHeight;
                            }
                        }

                        // Create canvas and compress
                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        // Convert to base64
                        resolve(canvas.toDataURL('image/jpeg', quality));
                    };
                    img.src = imageData;
                });
            }

            function selectColor(color, element) {
                $('.color_box').removeClass('selected');

                if (element) {
                    $(element).addClass('selected');
                    selectedColorBox = element;
                    // Update custom color input background
                    const hexColor = rgbToHex(color);
                    customColorInput.val(hexColor);
                    customColorInput[0].style.backgroundColor = hexColor;
                } else {
                    selectedColorBox = null;
                    // For direct color input changes
                    customColorInput[0].style.backgroundColor = color;
                }

                selectedColorInput.val(color);
            }

            // Custom color input handler
            customColorInput.on('input change', function () {
                const color = this.value;
                this.style.backgroundColor = color;
                selectColor(color);
            });

            function extractDominantColors(imageElement, numColors) {
                const colorThief = new ColorThief();
                try {
                    const palette = colorThief.getPalette(imageElement, numColors);
                    return palette.map(color => `rgb(${color[0]}, ${color[1]}, ${color[2]})`);
                } catch (error) {
                    console.error('Color extraction failed:', error);
                    return [];
                }
            }

            function rgbToHex(rgb) {
                if (rgb.startsWith('#')) return rgb;
                const rgbArray = rgb.match(/\d+/g);
                if (!rgbArray) return rgb;
                const hex = rgbArray.map(x => {
                    const hexValue = parseInt(x).toString(16);
                    return hexValue.length === 1 ? '0' + hexValue : hexValue;
                });
                return '#' + hex.join('');
            }

            function handleImage(file) {
                if (file) {
                    const reader = new FileReader();
                    reader.onload = async function (e) {
                        try {
                            const compressedImage = await compressImage(e.target.result);
                            imgCapture.attr('src', compressedImage).show();
                            cameraPlaceholder.hide();
                            btnReset.show(); // Show reset button

                            // Extract colors after image is loaded
                            const img = new Image();
                            img.onload = function () {
                                const dominantColors = extractDominantColors(this, 5);
                                dominantColorsContainer.empty();

                                // Add dominant color boxes
                                dominantColors.forEach((color, index) => {
                                    const colorBox = $('<div>')
                                        .addClass('color_box')
                                        .css('background-color', color)
                                        .click(function () {
                                            selectColor(color, this);
                                        });
                                    dominantColorsContainer.append(colorBox);

                                    if (index === 0) {
                                        selectColor(color, colorBox);
                                    }
                                });
                            };

                            img.crossOrigin = "Anonymous";
                            img.src = compressedImage;
                            analyzeWithAI(compressedImage);
                        } catch (error) {
                            console.error('Image compression error:', error);
                            alert('Error processing image. Please try again.');
                        }
                    };
                    reader.readAsDataURL(file);
                }
            }

            // Modal Controls
            function showModal() {
                apparelUploadModal.addClass('visible');
                imgCapture.hide();
                cameraPlaceholder.show();
                dominantColorsContainer.empty();
                selectColor(customColorInput.val());
                btnReset.hide();
            }

            function hideModal() {
                apparelUploadModal.removeClass('visible');
                imgCapture.hide();
                cameraPlaceholder.show();
                dominantColorsContainer.empty();
                selectColor(customColorInput.val());
                cameraInput.val('');
                galleryInput.val('');
                btnReset.hide();
                resetFormFields();
            }

            function resetFormFields() {
                $("[id$='ApparelNameInput']").val('');
                $("[id$='apparelTypeDropDown']").val('');
                $("[id$='selectedColorInput']").val('');
                $("[id$='SizeInput']").val('');
                $("[id$='AccessoryInput']").val('');
                $("[id$='ApparelDescriptionInput']").val('');
                customColorInput.val('#ffffff');
                customColorInput[0].style.backgroundColor = '#ffffff';
            }

            function validateFormInputs() {
                const apparelName = $("[id$='ApparelNameInput']").val().trim();
                const apparelType = $("[id$='apparelTypeDropDown']").val();
                const color = $("[id$='selectedColorInput']").val();
                const size = $("[id$='SizeInput']").val().trim();
                const accessoryType = $("[id$='AccessoryInput']").val().trim();
                const description = $("[id$='ApparelDescriptionInput']").val().trim();
                const imageData = imgCapture.attr('src');

                let errors = [];

                // Image validation
                if (!imageData) {
                    errors.push("Please capture or upload an image");
                }

                // Apparel name validation
                if (!apparelName) {
                    errors.push("Apparel name is required");
                } else if (apparelName.length < 3) {
                    errors.push("Apparel name must be at least 3 characters long");
                } else if (apparelName.length > 100) {
                    errors.push("Apparel name must not exceed 100 characters");
                }

                // Apparel type validation
                if (!apparelType) {
                    errors.push("Please select an apparel type");
                }

                // Color validation
                if (!color) {
                    errors.push("Please select a color");
                }

                // Size validation
                if (apparelType !== "Accessory" && !size) {
                    errors.push("Size is required");
                } else if (size.length > 20) {
                    errors.push("Size must not exceed 20 characters");
                }

                // Accessory type validation (only if apparel type is "Accessory")
                if (apparelType === "Accessory" && !accessoryType) {
                    errors.push("Please specify the type of accessory");
                }

                // Description validation
                if (description.length > 1000) {
                    errors.push("Description must not exceed 1000 characters");
                }

                return {
                    isValid: errors.length === 0,
                    errors: errors
                };
            }

            function showValidationErrors(errors) {
                const errorList = errors.join('\n• ');
                alert('Please fix the following errors:\n\n• ' + errorList);
            }

            window.goBack = function (e) {
                e.preventDefault();
                // Use browser's history
                if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = '/pages/Home.aspx';
                }
            };


            // Event Listeners
            openCameraBtn.click(() => cameraInput.click());
            openGalleryBtn.click(() => galleryInput.click());

            cameraInput.change(function (e) {
                handleImage(this.files[0]);
            });

            galleryInput.change(function (e) {
                handleImage(this.files[0]);
            });

            apparelUploadBtn.click(function (e) {
                e.preventDefault();
                showModal();
            });

            closeModalBtn.click(function (e) {
                e.preventDefault();
                hideModal();
            });

            btnReset.click(function (e) {
                e.preventDefault();
                imgCapture.hide();
                cameraPlaceholder.show();
                dominantColorsContainer.empty();
                selectColor(customColorInput.val());
                cameraInput.val('');
                galleryInput.val('');
                btnReset.hide(); // Hide reset button
            });

            finalSubmitBtn.click(async function (e) {
                e.preventDefault();

                const validation = validateFormInputs();
                if (!validation.isValid) {
                    showValidationErrors(validation.errors);
                    return;
                }

                // Get form values
                const apparelName = $("[id$='ApparelNameInput']").val();
                const apparelType = $("[id$='apparelTypeDropDown']").val();
                const color = $("[id$='selectedColorInput']").val();
                const size = $("[id$='SizeInput']").val();
                const accessoryType = $("[id$='AccessoryInput']").val();
                const description = $("[id$='ApparelDescriptionInput']").val();
                const originalImageData = imgCapture.attr('src');

                if (!originalImageData) {
                    alert('Please capture or upload an image first');
                    return;
                }

                if (!apparelName || !apparelType || !color) {
                    alert('Please fill in all required fields');
                    return;
                }

                // Show loading state
                finalSubmitBtn.prop('disabled', true);
                btnReset.find('i').addClass('loading-spinner');

                try {
                    // Compress image before sending
                    const compressedImageData = await compressImage(originalImageData);

                    // Get the absolute URL for the web service
                    const serviceUrl = window.location.protocol + '//' + window.location.host + '/services/ApparelService.asmx/SubmitApparel';

                    // Submit data
                    $.ajax({
                        type: "POST",
                        url: serviceUrl,
                        data: JSON.stringify({
                            username: username,
                            imageData: compressedImageData,
                            apparelName: apparelName,
                            apparelType: apparelType,
                            color: color,
                            size: size,
                            accessoryType: accessoryType,
                            description: description,
                            colorName: colorName
                        }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (response) {
                            if (response.d === "success") {
                                alert('Apparel added successfully!');
                                hideModal();
                                location.reload();
                            } else {
                                alert('Error: ' + response.d);
                                console.error('Server response:', response);
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('AJAX Error:', {
                                status: status,
                                error: error,
                                response: xhr.responseText
                            });
                            alert('Error submitting apparel. Please try again.\nError: ' + error);
                        },
                        complete: function () {
                            finalSubmitBtn.style('color', 'green');
                        }
                    });
                } catch (error) {
                    console.error('Image compression error:', error);
                    alert('Error processing image. Please try again.');
                    finalSubmitBtn.prop('disabled', false);
                }
            });

            // Accessory input toggle function
            function toggleAccessoryInput() {
                var selectedValue = $("#<%= apparelTypeDropDown.ClientID %>").val();
                var accessoryContainer = $("#<%= AccessoryInput.ClientID %>").parent();

                if (selectedValue === "Accessory") {
                    accessoryContainer.fadeIn();
                } else {
                    accessoryContainer.fadeOut();
                    $("#<%= AccessoryInput.ClientID %>").val('');
                }
            }

            toggleAccessoryInput();

            $("#<%= apparelTypeDropDown.ClientID %>").change(function () {
                toggleAccessoryInput();
            });

            $('#retryButton').click(function () {
                // Reset form
                resetFormFields();
                // Hide not apparel dialog
                $('#notApparelDialog').hide();
                // Hide captured image
                imgCapture.hide();
                // Show camera placeholder
                cameraPlaceholder.show();
                // Reset file inputs
                cameraInput.val('');
                galleryInput.val('');
                // Hide reset button
                btnReset.hide();
            });

        });


        // Accessory input toggle function
        $(document).ready(function () {
            function toggleAccessoryInput() {
                var selectedValue = $("#<%= apparelTypeDropDown.ClientID %>").val();
                var accessoryContainer = $("#<%= AccessoryInput.ClientID %>").parent();

                if (selectedValue === "Accessory") {
                    accessoryContainer.fadeIn();
                } else {
                    accessoryContainer.fadeOut();
                    $("#<%= AccessoryInput.ClientID %>").val('');
                }
            }

            toggleAccessoryInput();

            $("#<%= apparelTypeDropDown.ClientID %>").change(function () {
                toggleAccessoryInput();
            });
        });


    </script>


</body>
</html>
